# Offline (refresh) token — the one value you need. get_token.py --login prints it.
# .env is gitignored; real environment variables win over this file.
OFFLINE_TOKEN_ACCESS=

# Override only to reach a different realm or client.
# ACCESS_TOKEN_URL=https://login.cimenviro.com/auth/realms/cimenviro/protocol/openid-connect/token
# CLIENT_ID=api-external
# CLIENT_SECRET=

# Only for scripted --login runs (get_token.py --login). Prefer the interactive
# prompts — a password in .env is a password on disk. PEAK_TOTP goes stale in 30s.
# PEAK_USERNAME=
# PEAK_PASSWORD=
# PEAK_TOTP=
