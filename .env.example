# Everything here is optional. With no .env at all the tools read the offline
# token from ~/.local/secrets/aero_api and use the defaults below.

# Offline (refresh) token. Prefer OFFLINE_TOKEN_FILE — keeping the token in a
# file outside the repo means it cannot be committed by accident.
# OFFLINE_TOKEN_FILE=~/.local/secrets/aero_api
# OFFLINE_TOKEN_ACCESS=

# Override only to reach a different realm or client.
# ACCESS_TOKEN_URL=https://login.cimenviro.com/auth/realms/cimenviro/protocol/openid-connect/token
# CLIENT_ID=api-external
# CLIENT_SECRET=
